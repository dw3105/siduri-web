package site

import "strings"

templ a5Document(title string, lang string, preview bool, head []templ.Component, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			if preview {
				<meta name="robots" content="noindex"/>
			}
			<link rel="stylesheet" href="/site.css"/>
			for _, fragment := range head {
				@fragment
			}
		</head>
		<body>
			<header>
				<a href="/" aria-label="Siduri home"><strong>Siduri</strong></a>
				<nav aria-label="Primary">
					<a href="/journal/">Journal</a>
					<a href="/tools/">Tools</a>
					<a href="/about/">About</a>
					<a href="/contact/">Contact</a>
				</nav>
			</header>
			@content
			<footer>
				<a href="/about/">About</a> ·
				<a href="/stack/">Stack</a> ·
				<a href="/contact/">Contact</a> ·
				<a href="/impressum/">Impressum</a> ·
				<a href="/datenschutz/">Datenschutz</a>
			</footer>
		</body>
	</html>
}

templ a5HomePage(data PageData, head []templ.Component) {
	@a5Document("Siduri — human in the loop", "en", data.Preview, head, a5HomeContent(data.Posts))
}

templ a5HomeContent(posts []Post) {
	<main>
		<p class="post-meta">A journal about shipping software with agents.</p>
		<h1>Human in the loop.</h1>
		<p class="lede">Machines do the work. A person stays at the gate.</p>
		<p>I build small software systems with agents and keep a human responsible for what becomes public. Siduri is the record: tools built, failures understood, and useful software shipped with the boundary visible.</p>
		<p>The site is the artifact. Its source is Markdown, its output is static HTML, and its checks are part of the thing I ship. I write down the tools, the durations, the costs, and the dead ends so the method can be inspected rather than trusted on presentation.</p>
		<h2>Latest writing</h2>
		if len(posts) == 0 {
			<p>No published posts yet.</p>
		}
		for _, post := range posts {
			@a5PostCard(post)
		}
	</main>
}

templ a5PostCard(post Post) {
	<article class="post-card">
		<p class="post-meta"><time datetime={ post.Date }>{ post.Date }</time> · { readingTime(post.Body) } min read · { strings.Join(post.Tags, ", ") }</p>
		<h2><a href={ "/journal/" + post.Slug + "/" }>{ post.Title }</a></h2>
		<p>{ post.PlainSummary }</p>
	</article>
}

templ a5AboutPage(data PageData, head []templ.Component) {
	@a5Document("About — Siduri", "en", data.Preview, head, a5AboutContent())
}

templ a5AboutContent() {
	<main>
		<h1>About</h1>
		<p class="lede">I use agents to move quickly, and keep a person responsible for the result.</p>
		<p>I am building Siduri as a working example of that constraint. The generator is Go with templ. The content is Markdown. The output is a directory of static files that can be inspected, diffed, and served without a database or client-side framework.</p>
		<h2>Why Siduri</h2>
		<p>Siduri is the tavern keeper at the edge of the world in the <em>Epic of Gilgamesh</em>. Gilgamesh arrives grieving and looking for immortality. She tells him the hard truth: go home, eat your bread, wash, hold your child. Then she tells him where the ferryman is.</p>
		<p>That is the principle behind this site. I do not want an agent that claims to do everything, and I do not want a sceptic who refuses to help. I want a system that can take the next step quickly while a person decides what is true, useful, and ready to put in front of another person.</p>
		<h2>What makes this credible</h2>
		<p>There is no case-study theatre here yet. The evidence is the repository and the build: Go 1.26, templ-generated components, a closed tag vocabulary, Markdown posts, deterministic output, and tests that keep drafts out of the published tree. I will add claims when the work earns them and include the failures that changed the implementation.</p>
		<p>The <code>.ai</code> address is deliberately a tension. The work uses AI, but the brand does not hand over responsibility to it. Human review is not a disclaimer at the bottom; it is the gate in the workflow and the subject of the site.</p>
	</main>
}

templ a5ContactPage(data PageData, head []templ.Component) {
	@a5Document("Contact — Siduri", "en", data.Preview, head, a5ContactContent())
}

templ a5ContactContent() {
	<main>
		<h1>Contact</h1>
		<p><a href="mailto:hello@siduri.ai">hello@siduri.ai</a></p>
	</main>
}

templ a5StackPage(data PageData, head []templ.Component) {
	@a5Document("Stack — Siduri", "en", data.Preview, head, a5StackContent())
}

templ a5StackContent() {
	<main>
		<h1>Stack</h1>
		<p class="lede">The tools I actually use to make and publish this site.</p>
		<h2>Build</h2>
		<ul>
			<li><strong>Go 1.26</strong> owns loading, routing, rendering, and the build binary.</li>
			<li><strong>templ</strong> generates the type-safe HTML components. Generated Go files are committed so a clean checkout has a visible build boundary.</li>
			<li><strong>Markdown</strong> is the content format. A small repository renderer turns it into HTML; posts use a closed vocabulary of tags.</li>
		</ul>
		<h2>Runtime</h2>
		<ul>
			<li><strong>Static files</strong> are the product: HTML, CSS, feed data, and images can be served by an asset host.</li>
			<li><strong>CSS</strong> is plain and local. There is no UI framework, analytics beacon, or third-party script in the first build.</li>
			<li><strong>Git</strong> is the review surface. A draft remains a draft until a person changes that decision.</li>
		</ul>
		<h2>What I watch</h2>
		<p>Build time, output diffs, dependency count, and the places where an agent made a plausible but wrong assumption. The stack is allowed to change; the human gate is not.</p>
	</main>
}

templ a5NotFoundPage(data PageData, head []templ.Component) {
	@a5Document("Page not found — Siduri", "en", data.Preview, head, a5NotFoundContent())
}

templ a5NotFoundContent() {
	<main>
		<h1>Page not found</h1>
		<p class="lede">That route is not in the build.</p>
		<p><a href="/">Return to the home page.</a></p>
		<p><a href="/journal/">Browse the journal.</a></p>
	</main>
}

