package site

import "strings"

templ articlePage(post Post, body string, data PageData, head []templ.Component, sections ArticleSections) {
	@Document(post.Title+" — Siduri", data.Preview, head, articleContent(post, body, data.Preview, sections))
}

templ articleContent(post Post, body string, preview bool, sections ArticleSections) {
	<main>
		<article>
			<header class="article-header">
				<p class="post-meta"><time datetime={ post.Date }>{ post.Date }</time> · { readingTime(post.Body) } min read · { strings.Join(post.Tags, ", ") }</p>
				if post.Updated != "" && post.Updated != post.Date {
					<p class="post-meta">Updated <time datetime={ post.Updated }>{ post.Updated }</time></p>
				}
				<h1>{ post.Title }</h1>
				<p class="lede">{ post.PlainSummary }</p>
				if preview {
					<p class="draft-notice"><strong>Draft preview.</strong> This page is not part of the publish build.</p>
				}
			</header>
			@articleSectionComponents(sections.BodyAside)
			<div class="prose">
				@templ.Raw(body)
			</div>
			@articleSectionComponents(sections.AfterBody)
			<footer class="article-footer">
				<p>Written by Siduri.</p>
				<p>Newsletter capture is intentionally not part of this first build.</p>
				@articleSectionComponents(sections.Footer)
			</footer>
		</article>
	</main>
}

templ articleSectionComponents(components []templ.Component) {
	for _, component := range components {
		@component
	}
}
